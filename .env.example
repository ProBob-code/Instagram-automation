# IG Growth Hub - Environment Variables Template
# Copy this to .env and fill in your values

# ============================================
# REQUIRED FOR PRODUCTION
# ============================================

# Flask Secret Key (generate a random 32+ character string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database URL (Supabase PostgreSQL)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Redis URL (Upstash or local)
# Format: redis://:password@host:port
REDIS_URL=redis://localhost:6379/0

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================

# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# ============================================
# AI FEATURES (OPTIONAL)
# ============================================

# Groq API Key for AI suggestions
# Get from https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ============================================
# JWT CONFIGURATION
# ============================================

# Token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# ============================================
# FLASK CONFIGURATION
# ============================================

# Environment: development or production
FLASK_ENV=development

# Port (Railway will override this)
PORT=5000
